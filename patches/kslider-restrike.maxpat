      {
        "box": {
          "id": "obj-spec-embed",
          "maxclass": "text.codebox",
          "numinlets": 1,
          "numoutlets": 1,
          "outlettype": [
            ""
          ],
          "patching_rect": [
            50.0,
            665.0,
            500.0,
            300.0
          ],
          "code": "--- CLAUDE2MAX SPEC ---\n{\n  \"width\": 1098,\n  \"height\": 1084,\n  \"objects\": {\n    \"msg_plug\": {\n      \"type\": \"message\",\n      \"text\": \"plug\",\n      \"pos\": [\n        30,\n        60\n      ],\n      \"presentation\": [\n        22,\n        34,\n        50,\n        22\n      ],\n      \"inlets\": 2,\n      \"outlets\": 1,\n      \"outlettype\": [\n        \"\"\n      ]\n    },\n    \"msg_open\": {\n      \"type\": \"message\",\n      \"text\": \"open\",\n      \"pos\": [\n        90,\n        60\n      ],\n      \"presentation\": [\n        80,\n        34,\n        50,\n        22\n      ],\n      \"inlets\": 2,\n      \"outlets\": 1,\n      \"outlettype\": [\n        \"\"\n      ]\n    },\n    \"lbl_plug\": {\n      \"type\": \"comment\",\n      \"text\": \"load a plug-in  /  open its editor window\",\n      \"pos\": [\n        150,\n        60\n      ],\n      \"size\": [\n        300,\n        20\n      ],\n      \"presentation\": [\n        140,\n        36,\n        440,\n        20\n      ],\n      \"attrs\": {\n        \"fontname\": \"Monaco\",\n        \"fontsize\": 11.0,\n        \"textcolor\": [\n          0.92,\n          0.92,\n          0.92,\n          1.0\n        ],\n        \"bgcolor\": [\n          0.13,\n          0.13,\n          0.15,\n          1.0\n        ]\n      },\n      \"inlets\": 1,\n      \"outlets\": 0,\n      \"outlettype\": []\n    },\n    \"msg_flush\": {\n      \"type\": \"message\",\n      \"text\": \"flush\",\n      \"pos\": [\n        30,\n        130\n      ],\n      \"presentation\": [\n        22,\n        206,\n        60,\n        22\n      ],\n      \"inlets\": 2,\n      \"outlets\": 1,\n      \"outlettype\": [\n        \"\"\n      ]\n    },\n    \"lbl_flush\": {\n      \"type\": \"comment\",\n      \"text\": \"send note-offs for every held note\",\n      \"pos\": [\n        90,\n        130\n      ],\n      \"size\": [\n        260,\n        20\n      ],\n      \"presentation\": [\n        92,\n        208,\n        400,\n        20\n      ],\n      \"attrs\": {\n        \"fontname\": \"Monaco\",\n        \"fontsize\": 11.0,\n        \"textcolor\": [\n          0.92,\n          0.92,\n          0.92,\n          1.0\n        ],\n        \"bgcolor\": [\n          0.13,\n          0.13,\n          0.15,\n          1.0\n        ]\n      },\n      \"inlets\": 1,\n      \"outlets\": 0,\n      \"outlettype\": []\n    },\n    \"kslider\": {\n      \"type\": \"kslider\",\n      \"pos\": [\n        30,\n        190\n      ],\n      \"size\": [\n        336,\n        53\n      ],\n      \"attrs\": {\n        \"mode\": 1\n      },\n      \"presentation\": [\n        22,\n        104,\n        560,\n        83\n      ],\n      \"inlets\": 2,\n      \"outlets\": 2,\n      \"outlettype\": [\n        \"int\",\n        \"int\"\n      ],\n      \"box_extras\": {\n        \"mode\": 1,\n        \"parameter_enable\": 0\n      }\n    },\n    \"lbl_keys\": {\n      \"type\": \"comment\",\n      \"text\": \"polyphonic: click a key once for note-on, again for note-off\",\n      \"pos\": [\n        30,\n        250\n      ],\n      \"size\": [\n        420,\n        20\n      ],\n      \"presentation\": [\n        22,\n        178,\n        560,\n        20\n      ],\n      \"attrs\": {\n        \"fontname\": \"Monaco\",\n        \"fontsize\": 11.0,\n        \"textcolor\": [\n          0.92,\n          0.92,\n          0.92,\n          1.0\n        ],\n        \"bgcolor\": [\n          0.13,\n          0.13,\n          0.15,\n          1.0\n        ]\n      },\n      \"inlets\": 1,\n      \"outlets\": 0,\n      \"outlettype\": []\n    },\n    \"join\": {\n      \"type\": \"newobj\",\n      \"text\": \"join 2\",\n      \"pos\": [\n        30,\n        300\n      ],\n      \"inlets\": 2,\n      \"outlets\": 1,\n      \"outlettype\": [\n        \"\"\n      ]\n    },\n    \"v8\": {\n      \"type\": \"newobj\",\n      \"text\": \"v8 kslider-restrike.js @embed 1\",\n      \"pos\": [\n        470,\n        300\n      ],\n      \"inlets\": 1,\n      \"outlets\": 2,\n      \"outlettype\": [\n        \"\",\n        \"\"\n      ],\n      \"attrs\": {\n        \"filename\": \"kslider-restrike.js\",\n        \"textfile\": {\n          \"filename\": \"kslider-restrike.js\",\n          \"flags\": 0,\n          \"embed\": 1,\n          \"autowatch\": 1,\n          \"text\": \"// kslider-restrike.js \\u2014 remembers which notes a polyphonic kslider is holding,\\n// and on \\\"restrike\\\" flushes the keyboard and plays the same notes again.\\n//\\n// inlet 0  : \\\"<pitch> <velocity>\\\" lists.\\n//            velocity > 0 stores the pitch; velocity 0 (note-off) removes it.\\n//            \\\"restrike\\\" \\u2014 emit \\\"flush\\\", then one \\\"chord\\\" message carrying\\n//                         every stored pitch/velocity pair.\\n//            \\\"clear\\\"    \\u2014 forget every stored note without emitting anything.\\n// outlet 0 : messages for a kslider \\u2014 exactly two per restrike, in this\\n//            order: \\\"flush\\\", then \\\"chord p1 v1 p2 v2 ...\\\". Nothing else is\\n//            ever sent here.\\n// outlet 1 : the currently stored pitches as a list, or the symbol \\\"(none)\\\"\\n//            when nothing is stored.\\n//\\n// kslider's \\\"chord\\\" message (polyphonic mode) displays AND outputs the notes,\\n// so a kslider driven by outlet 0 emits the restruck notes again; if those\\n// come back to inlet 0 they are simply stored again.\\n\\ninlets = 1;\\noutlets = 2;\\nautowatch = 1;\\n\\n// Hover text for each inlet and outlet in Max. Describes what the port accepts or\\n// emits \\u2014 never the objects it happens to be wired to in a particular patch.\\nsetinletassist(0, \\\"pitch velocity (list): velocity > 0 stores, 0 forgets; restrike; clear\\\");\\nsetoutletassist(0, \\\"kslider messages: flush, then chord p1 v1 p2 v2 ...\\\");\\nsetoutletassist(1, \\\"stored pitches (list), or (none)\\\");\\n\\nvar HELD = new Map();          // pitch -> velocity of the note-on that lit it\\n\\nfunction list(pitch, velocity) {\\n    if (velocity > 0) {\\n        HELD.set(pitch, velocity);\\n    } else {\\n        HELD.delete(pitch);\\n    }\\n    report();\\n}\\n\\nfunction restrike() {\\n    // Snapshot first: the flush below makes the kslider emit note-offs, which\\n    // come straight back into list() and empty HELD before the chord goes out.\\n    var PAIRS = [];\\n    HELD.forEach(function (velocity, pitch) {\\n        if (velocity > 0) { PAIRS.push(pitch, velocity); }\\n    });\\n    outlet(0, \\\"flush\\\");\\n    if (PAIRS.length > 0) {\\n        outlet(0, \\\"chord\\\", ...PAIRS);\\n    }\\n    report();\\n}\\n\\nfunction clear() {\\n    HELD.clear();\\n    report();\\n}\\n\\nfunction report() {\\n    var PITCHES = Array.from(HELD.keys()).sort(function (a, b) { return a - b; });\\n    if (PITCHES.length === 0) {\\n        outlet(1, \\\"(none)\\\");\\n    } else {\\n        outlet(1, ...PITCHES);\\n    }\\n}\\n\"\n        }\n      },\n      \"box_extras\": {\n        \"saved_object_attributes\": {\n          \"parameter_enable\": 0\n        }\n      }\n    },\n    \"lbl_v8\": {\n      \"type\": \"comment\",\n      \"text\": \"out 0 feeds back UP into the kslider: flush, then one chord message\",\n      \"pos\": [\n        470,\n        340\n      ],\n      \"size\": [\n        270,\n        34\n      ],\n      \"attrs\": {\n        \"fontname\": \"Monaco\",\n        \"fontsize\": 11.0\n      },\n      \"inlets\": 1,\n      \"outlets\": 0,\n      \"outlettype\": []\n    },\n    \"lbl_stored\": {\n      \"type\": \"comment\",\n      \"text\": \"stored pitches\",\n      \"pos\": [\n        680,\n        450\n      ],\n      \"size\": [\n        110,\n        20\n      ],\n      \"presentation\": [\n        450,\n        272,\n        140,\n        20\n      ],\n      \"attrs\": {\n        \"fontname\": \"Monaco\",\n        \"fontsize\": 11.0,\n        \"textcolor\": [\n