,\n                  \"\\u2022\"\n                ],\n                [\n                  \"_codebg\",\n                  0.0,\n                  0.0,\n                  0.0,\n                  0.18\n                ],\n                [\n                  \"_headingscale\",\n                  0.75\n                ],\n                [\n                  \"_hyperlinkcolor\",\n                  0.2,\n                  0.45,\n                  0.95,\n                  1\n                ],\n                [\n                  \"_indent\",\n                  14\n                ],\n                [\n                  \"_linespacing\",\n                  1.2\n                ],\n                [\n                  \"_linkunderline\",\n                  1\n                ],\n                [\n                  \"_markdown\",\n                  1\n                ],\n                [\n                  \"_monofont\",\n                  \"\"\n                ],\n                [\n                  \"_padding\",\n                  8\n                ],\n                [\n                  \"_paraspacing\",\n                  0.5\n                ],\n                [\n                  \"_pointsize\",\n                  12,\n                  10\n                ],\n                [\n                  \"_sendto\",\n                  \"\"\n                ],\n                [\n                  \"_tablecolor\",\n                  0.45,\n                  0.46,\n                  0.5,\n                  0.7\n                ],\n                [\n                  \"_tablefill\",\n                  1\n                ],\n                [\n                  \"_tablepad\",\n                  4\n                ],\n                [\n                  \"_tablewrap\",\n                  0.3\n                ],\n                [\n                  \"_text\",\n                  \"Neither object has a single attribute. Every control on this page is an inlet.<br>## Overlaps<br>\\u2014<br>{b}object|what it is instead<br>`sah~`|the primitive underneath sample-rate reduction: hold a value until a trigger says otherwise<br>`trunc~` on tab 3|the bit-depth half on its own at one bit<br>`round~ @nearest`|quantise amplitude to any step rather than only a power of two<br>\\u2014<br><br>## Packages<br>\\u2014<br>{b}package|what it adds<br>**ableton-dsp** *ships inside Max*|`abl.device.redux~` is the full version: `@rate` in Hz \\u00b7 `@bitdepth` 1 to 16 \\u00b7 `@jitter` \\u00b7 a `@prefilter` and a `@post_filter` that decide how much aliasing survives \\u00b7 `@shape` morphs the quantiser between linear and A-law<br>**Upshot**|`upshot_bitcrusher` \\u2014 a simpler wrapper around the same idea<br>**ears**|no offline equivalent. These two are realtime only.<br>\\u2014\"\n                ],\n                [\n                  \"_wrap\",\n                  1\n                ]\n              ]\n            }\n          }\n        },\n        \"connections\": [\n          [\n            \"gain_init\",\n            0,\n            \"gain\",\n            0\n          ],\n          [\n            \"src_in\",\n            0,\n            \"drive\",\n            0\n          ],\n          [\n            \"gain\",\n            0,\n            \"drive\",\n            1\n          ],\n          [\n            \"gi_1\",\n            0,\n            \"gj_1\",\n            0\n          ],\n          [\n            \"gj_1\",\n            0,\n            \"ratio\",\n            0\n          ],\n          [\n            \"gj_1\",\n            1,\n            \"bits\",\n            0\n          ],\n          [\n            \"drive\",\n            0,\n            \"deg\",\n            0\n          ],\n          [\n            \"deg\",\n            0,\n            \"sel\",\n            1\n          ],\n          [\n            \"dsrate_init\",\n            0,\n            \"dsrate\",\n            0\n          ],\n          [\n            \"drive\",\n        