or\": [\n                0.9,\n                0.9,\n                0.92,\n                1.0\n              ],\n              \"fontface\": 1\n            },\n            \"presentation\": [\n              30,\n              2074,\n              1100,\n              21\n            ],\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"b15_desc\": {\n            \"type\": \"comment\",\n            \"text\": \"buffer~ has no fill attribute: fill and apply are messages.  Everything here rewrites the same table, so cycle~ (block 1) and wave~ (block 9) both change with it.\",\n            \"pos\": [\n              30,\n              2435\n            ],\n            \"size\": [\n              1100,\n              21\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 9.0,\n              \"textcolor\": [\n                0.68,\n                0.7,\n                0.74,\n                1.0\n              ]\n            },\n            \"presentation\": [\n              30,\n              2101,\n              1100,\n              21\n            ],\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"rt_sin1\": {\n            \"type\": \"message\",\n            \"text\": \"fill sin 1\",\n            \"pos\": [\n              30,\n              2462\n            ],\n            \"size\": [\n              102,\n              22\n            ],\n            \"presentation\": [\n              30,\n              2128,\n              102,\n              22\n            ],\n            \"inlets\": 2,\n            \"outlets\": 1,\n            \"outlettype\": [\n              \"\"\n            ]\n          },\n          \"rt_sin1_n\": {\n            \"type\": \"comment\",\n            \"text\": \"one cycle of sine: the plain waveform\",\n            \"pos\": [\n              260,\n              2464\n            ],\n            \"size\": [\n              870,\n              21\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 9.0,\n              \"textcolor\": [\n                0.68,\n                0.7,\n                0.74,\n                1.0\n              ]\n            },\n            \"presentation\": [\n              260,\n              2130,\n              870,\n              21\n            ],\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"rt_sin3\": {\n            \"type\": \"message\",\n            \"text\": \"fill sin 3\",\n            \"pos\": [\n              30,\n              2492\n            ],\n            \"size\": [\n              102,\n              22\n            ],\n            \"presentation\": [\n              30,\n              2158,\n              102,\n              22\n            ],\n            \"inlets\": 2,\n            \"outlets\": 1,\n            \"outlettype\": [\n              \"\"\n            ]\n          },\n          \"rt_sin3_n\": {\n            \"type\": \"comment\",\n            \"text\": \"three cycles in the same table, so reading it plays the third harmonic\",\n            \"pos\": [\n              260,\n              2494\n            ],\n            \"size\": [\n              870,\n              21\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 9.0,\n              \"textcolor\": [\n                0.68,\n                0.7,\n                0.74,\n                1.0\n              ]\n            },\n            \"presentation\": [\n              260,\n              2160,\n              870,\n              21\n            ],\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"rt_cos4\": {\n            \"type\": \"message\",\n            \"text\": \"fill cos 1 4\",\n            \"pos\": [\n              30,\n              2522\n            ],\n            \"size\": [\n              114,\n              22\n            ],\n            \"presentation\": [\n              30,\n              2188,\n              114,\n              22\n            ],\n            \"inlets\": 2,\n            \"outlets\": 1,\n            \"outlettype\": [\n              \"\"\n            ]\n          },\n          \"rt_cos4_n\": {\n            \"type\": \"comment\",\n            \"text\": \"a rational count \\u2014 one QUARTER of a cosine.  It rises from 0. to 1. and stops, so it is a soft-knee curve rather than a waveform\",\n            \"pos\": [\n              260,\n              2524\n            ],\n            \"size\": [\n              870,\n              21\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 9.0,\n              \"textcolor\": [\n                0.68,\n                0.7,\n                0.74,\n                1.0\n              ]\n            },\n            \"presentation\": [\n              260,\n              2190,\n              870,\n              21\n            ],\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"rt_cos2\": {\n            \"type\": \"message\",\n            \"text\": \"fill cos 1 2\",\n            \"pos\": [\n              30,\n              2552\n            ],\n            \"size\": [\n              114,\n              22\n            ],\n            \"presentation\": [\n              30,\n              2218,\n              114,\n              22\n            ],\n            \"inlets\": 2,\n            \"outlets\": 1,\n            \"outlettype\": [\n              \"\"\n            ]\n          },\n          \"rt_cos2_n\": {\n            \"type\": \"comment\",\n            \"text\": \"half a cosine: a full sweep from 1. down to -1., a symmetrical S\",\n            \"pos\": [\n              260,\n              2554\n            ],\n            \"size\": [\n              870,\n              21\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 9.0,\n              \"textcolor\": [\n                0.68,\n                0.7,\n                0.74,\n                1.0\n              ]\n            },\n            \"presentation\": [\n              260,\n              2220,\n              870,\n              21\n            ],\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"rt_snc2\": {\n            \"type\": \"message\",\n            \"text\": \"fill sinc 2 1\",\n            \"pos\": [\n              30,\n              2582\n            ],\n            \"size\": [\n              120,\n              22\n            ],\n            \"presentation\": [\n              30,\n              2248,\n              120,\n              22\n            ],\n            \"inlets\": 2,\n            \"outlets\": 1,\n            \"outlettype\": [\n              \"\"\n            ]\n          },\n          \"rt_snc2_n\": {\n            \"type\": \"comment\",\n            \"text\": \"sinc is sin(x)/x.  The first number is how many times it crosses zero on each side: 2 gives a broad bell with a single ripple, a soft tone\",\n            \"pos\": [\n              260,\n              2584\n            ],\n            \"size\": [\n              870,\n              21\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 9.0,\n              \"textcolor\": [\n                0.68,\n                0.7,\n                0.74,\n                1.0\n              ]\n            },\n            \"presentation\": [\n              260,\n              2250,\n              870,\n              21\n            ],\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"rt_snc4\": {\n            \"type\": \"message\",\n            \"text\": \"fill sinc 4 1\",\n            \"pos\": [\n              30,\n              2612\n            ],\n            \"size\": [\n              120,\n              22\n            ],\n            \"presentation\": [\n              30,\n              2278,\n              120,\n              22\n            ],\n            \"inlets\": 2,\n            \"outlets\": 1,\n            \"outlettype\": [\n              \"\"\n            ]\n          },\n          \"rt_snc4_n\": {\n            \"type\": \"comment\",\n            \"text\": \"4 crossings: more ripples, a brighter and more nasal tone\",\n            \"pos\": [\n              260,\n              2614\n            ],\n            \"size\": [\n              870,\n              21\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 9.0,\n              \"textcolor\": [\n                0.68,\n                0.7,\n                0.74,\n                1.0\n              ]\n            },\n            \"presentation\": [\n              260,\n              2280,\n              870,\n              21\n            ],\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"rt_snc8\": {\n            \"type\": \"message\",\n            \"text\": \"fill sinc 8 1\",\n            \"pos\": [\n              30,\n              2642\n            ],\n            \"size\": [\n              120,\n              22\n            ],\n            \"presentation\": [\n              30,\n              2308,\n              120,\n              22\n            ],\n            \"inlets\": 2,\n            \"outlets\": 1,\n            \"outlettype\": [\n              \"\"\n            ]\n          },\n          \"rt_snc8_n\": {\n            \"type\": \"comment\",\n            \"text\": \"8 crossings: a narrow spike with a long ringing tail, the brightest of the three\",\n            \"pos\": [\n              260,\n              2644\n            ],\n            \"size\": [\n              870,\n              21\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 9.0,\n              \"textcolor\": [\n                0.68,\n                0.7,\n                0.74,\n                1.0\n              ]\n            },\n            \"presentation\": [\n              260,\n              2310,\n              870,\n              21\n            ],\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"rt_snc80\": {\n            \"type\": \"message\",\n            \"text\": \"fill sinc 8 0\",\n            \"pos\": [\n              30,\n              2672\n            ],\n            \"size\": [\n              120,\n              22\n            ],\n            \"presentation\": [\n              30,\n              2338,\n              120,\n              22\n            ],\n            \"inlets\": 2,\n            \"outlets\": 1,\n            \"outlettype\": [\n              \"\"\n            ]\n          },\n          \"rt_snc80_n\": {\n            \"type\": \"comment\",\n            \"text\": \"the same 8 crossings with the second flag at 0: the function does NOT start at zero, so the peak moves to the edge of the table and it reads as a decaying ring instead of a symmetrical pulse\",\n            \"pos\": [\n              260,\n              2674\n            ],\n            \"size\": [\n              870,\n              36\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 9.0,\n              \"textcolor\": [\n                0.68,\n                0.7,\n                0.74,\n                1.0\n              ],\n              \"presentation_linecount\": 2\n            },\n            \"pre