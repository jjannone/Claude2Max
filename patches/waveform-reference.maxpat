    \"size\": [\n              1100,\n              24\n            ],\n            \"presentation\": [\n              20,\n              14,\n              1100,\n              24\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 13.0,\n              \"fontface\": 1,\n              \"textcolor\": [\n                1.0,\n                0.55,\n                0.0,\n                1.0\n              ]\n            },\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"blurb\": {\n            \"type\": \"comment\",\n            \"text\": \"The buffer~ holds the transfer curve.  The input's instantaneous amplitude, -1. to 1., picks a point along the table, and the value found there is the output \\u2014 so the shape of the curve IS the timbre.  Drive it to full scale: a quieter signal only ever reads the middle of the table.  The waveform~ shows the curve you are hearing, so changing it changes the sound and the picture together.\",\n            \"pos\": [\n              20,\n              44\n            ],\n            \"size\": [\n              1100,\n              51\n            ],\n            \"presentation\": [\n              20,\n              44,\n              1100,\n              52\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 10.0,\n              \"textcolor\": [\n                0.9,\n                0.9,\n                0.92,\n                1.0\n              ],\n              \"presentation_linecount\": 3\n            },\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"src_in\": {\n            \"type\": \"newobj\",\n            \"text\": \"r~ SRC\",\n            \"pos\": [\n              20,\n              140\n            ],\n            \"inlets\": 1,\n            \"outlets\": 1,\n          