          "code": "--- CLAUDE2MAX SPEC ---\n{\n  \"width\": 1000,\n  \"height\": 800,\n  \"bglocked\": 1,\n  \"objects\": {\n    \"title\": {\n      \"type\": \"comment\",\n      \"text\": \"Waveform generation & waveshaping \\u2014 a reference patch\",\n      \"pos\": [\n        20,\n        14\n      ],\n      \"size\": [\n        800,\n        26\n      ],\n      \"presentation\": [\n        26,\n        18,\n        700,\n        26\n      ],\n      \"attrs\": {\n        \"fontname\": \"Monaco\",\n        \"fontsize\": 15.0,\n        \"fontface\": 1,\n        \"textcolor\": [\n          1.0,\n          0.55,\n          0.0,\n          1.0\n        ]\n      },\n      \"inlets\": 1,\n      \"outlets\": 0,\n      \"outlettype\": []\n    },\n    \"howto\": {\n      \"type\": \"comment\",\n      \"text\": \"Tab 1 holds every generator.  Pick one there and it feeds [s~ SRC], which every waveshaping tab reads \\u2014 so no other tab carries a source of its own, and changing the source changes what all of them are shaping.\\n\\nAny tab's \\\"to output\\\" toggle puts that tab onto the master bus below.  They sum, so two left on are heard together.  Click the speaker to start audio.\\n\\nEvery page is built from blocks: one block per object, its controls stacked down the left with what each one does written beside it, and the object itself at the foot of the block.  An [attrui] means the object really has that attribute.\\n\\nEach tab shows its result on a live.scope~ in trigger mode over 800 samples, triggered by the unshaped source so the trace stays still.  Tab 7 lists every object in one place.\",\n      \"pos\": [\n        20,\n        50\n      ],\n      \"size\": [\n        560,\n        260\n      ],\n      \"presentation\": [\n        26,\n        56,\n        560,\n        260\n      ],\n      \"attrs\": {\n        \"fontname\": \"Monaco\",\n        \"fontsize\": 10.0,\n        \"textcolor\": [\n          0.9,\n          0.9,\n          0.92,\n          1.0\n        ],\n        \"presentation_linecount\": 13\n      },\n      \"inlets\": 1,\n      \"outlets\": 0,\n      \"outlettype\": []\n    },\n    \"index\": {\n      \"type\": \"comment\",\n      \"text\": \"GENERATION\\n\\n  1 sources\\n\\nWAVESHAPING\\n\\n  2 overdrive~ pong~\\n  3 signal maths\\n  4 lookup~\\n  5 degrade~ downsamp~\\n  6 package waveshapers\\n\\nREFERENCE\\n\\n  7 overlaps & sources\",\n      \"pos\": [\n        620,\n        50\n      ],\n      \"size\": [\n        340,\n        260\n      ],\n      \"presentation\": [\n        620,\n        56,\n        330,\n        260\n      ],\n      \"attrs\": {\n        \"fontname\": \"Monaco\",\n        \"fontsize\": 10.0,\n        \"textcolor\": [\n          0.68,\n          0.7,\n          0.74,\n          1.0\n        ],\n        \"presentation_linecount\": 15\n      },\n      \"inlets\": 1,\n      \"outlets\": 0,\n      \"outlettype\": []\n    },\n    \"r_l\": {\n      \"type\": \"newobj\",\n      \"text\": \"r~ REF_L\",\n      \"pos\": [\n        20,\n        340\n      ],\n      \"inlets\": 1,\n      \"outlets\": 1,\n      \"outlettype\": [\n        \"\"\n      ]\n    },\n    \"r_r\": {\n      \"type\": \"newobj\",\n      \"text\": \"r~ REF_R\",\n      \"pos\": [\n        150,\n        340\n      ],\n      \"inlets\": 1,\n      \"outlets\": 1,\n      \"outlettype\": [\n        \"\"\n      ]\n    },\n    \"gain\": {\n      \"type\": \"live.gain~\",\n      \"pos\": [\n        20,\n        410\n      ],\n      \"presentation\": [\n        30,\n        340,\n        24,\n        130\n      ],\n      \"attrs\": {\n        \"varname\": \"MASTER_GAIN\"\n      },\n      \"inlets\": 2,\n      \"outlets\": 5,\n      \"outlettype\": [\n        \"signal\",\n        \"signal\",\n        \"\",\n        \"float\",\n        \"list\"\n      ]\n    },\n    \"gain_lbl\": {\n      \"type\": \"comment\",\n      \"text\": \"master\",\n      \"pos\": [\n        60,\n        412\n      ],\n      \"size\": [\n        90,\n        18\n      ],\n      \"attrs\": {\n        \"fontname\": \"Monaco\",\n        \"fontsize\": 10.0,\n        \"textcolor\": [\n          0.9,\n          0.9,\n          0.92,\n          1.0\n        ]\n      },\n      \"presentation\": [\n        62,\n        340,\n        90,\n        20\n      ],\n      \"inlets\": 1,\n      \"outlets\": 0,\n      \"outlettype\": []\n    },\n    \"dac\": {\n      \"type\": \"ezdac~\",\n      \"pos\": [\n        20,\n        560\n      ],\n      \"presentation\": [\n        30,\n        486,\n        45,\n        45\n      ],\n      \"inlets\": 2,\n      \"outlets\": 0,\n      \"outlettype\": []\n    },\n    \"dac_lbl\": {\n      \"type\": \"comment\",\n      \"text\": \"click to start audio\",\n      \"pos\": [\n        80,\n        572\n      ],\n      \"size\": [\n        200,\n        18\n      ],\n      \"attrs\": {\n        \"fontname\": \"Monaco\",\n        \"fontsize\": 10.0,\n        \"textcolor\": [\n          0.9,\n          0.9,\n          0.92,\n          1.0\n        ]\n      },\n      \"presentation\": [\n        84,\n        498,\n        200,\n        20\n      ],\n      \"inlets\": 1,\n      \"outlets\": 0,\n      \"outlettype\": []\n    },\n    \"master_scope\": {\n      \"type\": \"live.scope~\",\n      \"pos\": [\n        280,\n        420\n      ],\n      \"presentation\": [\n        300,\n        366,\n        320,\n        164\n      ],\n      \"attrs\": {\n        \"mode\": 0,\n        \"samples\": 800.0,\n        \"trigger_threshold\": 0.0,\n        \"trigger_direction\": 1,\n        \"grid\": 3,\n        \"vertical_divisions\": 4,\n        \"horizontal_divisions\": 8,\n        \"rounded\": 3.0,\n        \"bgcolor\": [\n          0.1,\n          0.11,\n          0.13,\n          1.0\n        ],\n        \"activebgcolor\": [\n          0.1,\n          0.11,\n          0.13,\n          1.0\n        ],\n        \"linecolor\": [\n          1.0,\n          0.55,\n          0.0,\n          1.0\n        ],\n        \"activelinecolor\": [\n          1.0,\n          0.55,\n          0.0,\n          1.0\n        ],\n        \"gridcolor\": [\n          0.28,\n          0.29,\n          0.32,\n          1.0\n        ],\n        \"activegridcolor\": [\n          0.28,\n          0.29,\n          0.32,\n          1.0\n        ]\n      },\n      \"inlets\": 2,\n      \"outlets\": 1,\n      \"outlettype\": [\n        \"bang\"\n      ],\n      \"box_extras\": {\n        \"mode\": 0,\n        \"samples\": 800.0,\n        \"trigger_threshold\": 0.0,\n        \"trigger_direction\": 1,\n        \"grid\": 3,\n        \"vertical_divisions\": 4,\n        \"horizontal_divisions\": 8,\n        \"activebgcolor\": [\n          0.1,\n          0.11,\n          0.13,\n          1.0\n        ],\n        \"linecolor\": [\n          1.0,\n          0.55,\n          0.0,\n          1.0\n        ],\n        \"activelinecolor\": [\n          1.0,\n          0.55,\n          0.0,\n          1.0\n        ],\n        \"gridcolor\": [\n          0.28,\n          0.29,\n          0.32,\n          1.0\n        ],\n        \"activegridcolor\": [\n          0.28,\n          0.29,\n          0.32,\n          1.0\n        ]\n      }\n    },\n    \"scope_lbl\": {\n      \"type\": \"comment\",\n      \"text\": \"what is on the master bus (history mode: the bus has no single trigger)\",\n      \"pos\": [\n        280,\n        370\n      ],\n      \"size\": [\n        330,\n        38\n      ],\n      \"attrs\": {\n        \"fontname\": \"Monaco\",\n        \"fontsize\": 10.0,\n        \"textcolor\": [\n          0.9,\n          0.9,\n          0.92,\n          1.0\n        ],\n        \"presentation_linecount\": 2\n      },\n      \"presentation\": [\n        300,\n        324,\n        330,\n        38\n      ],\n      \"inlets\": 1,\n      \"outlets\": 0,\n      \"outlettype\": []\n    },\n    \"panel\": {\n      \"type\": \"panel\",\n      \"pos\": [\n        20,\n        660\n      ],\n      \"size\": [\n        120,\n        28\n      ],\n      \"presentation\": [\n        10,\n        8,\n        960,\n        560\n      ],\n      \"attrs\": {\n        \"background\": 1,\n        \"rounded\": 8,\n        \"bgcolor\": [\n          0.15,\n          0.16,\n          0.19,\n          1.0\n        ]\n      },\n      \"inlets\": 1,\n      \"outlets\": 0,\n      \"outlettype\": []\n    },\n    \"tab_sources\": {\n      \"type\": \"newobj\",\n      \"text\": \"p \\\"1 sources\\\"\",\n      \"pos\": [\n        620,\n        400\n      ],\n      \"inlets\": 0,\n      \"outlets\": 0,\n      \"outlettype\": [],\n      \"attrs\": {\n        \"comment\": \"no inlets or outlets \\u2014 this subpatcher is a tab of the window; it reaches the master output through s~ REF_L / s~ REF_R\"\n      },\n      \"patcher\": {\n        \"width\": 1160,\n        \"height\": 4335,\n        \"bglocked\": 1,\n        \"objects\": {\n          \"header\": {\n            \"type\": \"comment\",\n            \"text\": \"1 \\u00b7 Sources \\u2014 every waveform generator, with the shaping each one carries\",\n            \"pos\": [\n              20,\n              14\n            ],\n            \"size\": [\n              1100,\n              24\n            ],\n            \"presentation\": [\n              20,\n              14,\n              1100,\n              24\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 13.0,\n              \"fontface\": 1,\n              \"textcolor\": [\n                1.0,\n                0.55,\n                0.0,\n                1.0\n              ]\n            },\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"blurb\": {\n            \"type\": \"comment\",\n            \"text\": \"Pick a source in the first block; it feeds [s~ SRC], which every waveshaping tab reads, and the scope at the end of this page.  One block per object: its controls stack down the left, what each one does is written beside it, and the object itself sits at the bottom of the block.  An [attrui] means the object really has that attribute.  Where a block has none, the object has no attributes at all and everything is a creation argument or an inlet \\u2014 saw~, tri~, rect~, click~, pink~, rand~, kink~ and ioscbank~ are all in that group.\",\n            \"pos\": [\n              20,\n              44\n            ],\n            \"size\": [\n              1100,\n              66\n            ],\n            \"presentation\": [\n              20,\n              44,\n              1100,\n              66\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 10.0,\n              \"textcolor\": [\n                0.9,\n                0.9,\n                0.92,\n                1.0\n              ],\n              \"presentation_linecount\": 3\n            },\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"b0_title\": {\n            \"type\": \"comment\",\n            \"text\": \"which source\",\n            \"pos\": [\n              30,\n              238\n            ],\n            \"size\": [\n              530,\n              21\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 10.0,\n              \"textcolor\": [\n                0.9,\n                0.9,\n                0.92,\n                1.0\n              ],\n              \"fontface\": 1\n            },\n            \"presentation\": [\n              30,\n              238,\n              530,\n              21\n            ],\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"b0_desc\": {\n            \"type\": \"comment\",\n            \"text\": \"The blocks below are in this order, reading left to right along each row.\",\n            \"pos\": [\n              30,\n              265\n            ],\n            \"size\": [\n              530,\n              21\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 9.0,\n              \"textcolor\": [\n                0.68,\n                0.7,\n                0.74,\n                1.0\n              ]\n            },\n            \"presentation\": [\n              30,\n              265,\n              530,\n              21\n            ],\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"pick\": {\n            \"type\": \"live.tab\",\n            \"attrs\": {\n              \"num_lines_patching\": 14,\n              \"num_lines_presentation\": 14,\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 10.0,\n              \"spacing_x\": 3.0,\n              \"spacing_y\": 3.0,\n              \"rounded\": 3.0,\n              \"bgcolor\": [\n                0.3,\n                0.3,\n                0.32,\n                1.0\n              ],\n              \"bgoncolor\": [\n                1.0,\n                0.55,\n                0.0,\n                1.0\n              ],\n              \"textcolor\": [\n                0.9,\n                0.9,\n                0.92,\n                1.0\n              ],\n              \"textoncolor\": [\n                0.08,\n                0.08,\n                0.09,\n                1.0\n              ],\n              \"parameter_enable\": 1,\n              \"saved_attribute_attributes\": {\n                \"bgcolor\": {\n                  \"expression\": \"\"\n                },\n                \"bgoncolor\": {\n                  \"expression\": \"\"\n                },\n                \"textcolor\": {\n                  \"expression\": \"\"\n                },\n                \"textoncolor\": {\n                  \"expression\": \"\"\n                },\n                \"valueof\": {\n                  \"parameter_enum\": [\n                    \"1 cycle~\",\n                    \"2 phasor~\",\n                    \"3 phase dist\",\n                    \"4 saw~\",\n                    \"5 tri~\",\n                    \"6 rect~\",\n                    \"7 train~\",\n                    \"8 click~\",\n                    \"9 wave~\",\n                    \"10 noise~\",\n                    \"11 pink~\",\n                    \"12 rand~\",\n                    \"13 ioscbank~\",\n                    \"14 meldosc~\"\n                  ],\n                  \"parameter_initial\": [\n                    0\n                  ],\n                  \"parameter_longname\": \"SOURCE_SELECT\",\n                  \"parameter_mmax\": 13,\n                  \"parameter_modmode\": 0,\n                  \"parameter_shortname\": \"SOURCE_SELECT\",\n                  \"parameter_type\": 2,\n                  \"parameter_unitstyle\": 9\n                }\n              },\n              \"varname\": \"SOURCE_SELECT\"\n            },\n            \"pos\": [\n              30,\n              292\n            ],\n            \"size\": [\n              200,\n              308\n            ],\n            \"presentation\": [\n              30,\n              292,\n              200,\n              308\n            ],\n            \"inlets\": 1,\n            \"outlets\": 3,\n            \"outlettype\": [\n              \"\",\n              \"\",\n              \"float\"\n            ],\n            \"box_extras\": {\n              \"num_lines_patching\": 14,\n              \"num_lines_presentation\": 14,\n              \"spacing_x\": 3.0,\n              \"spacing_y\": 3.0,\n              \"bgoncolor\": [\n                1.0,\n                0.55,\n                0.0,\n                1.0\n              ],\n              \"textoncolor\": [\n                0.08,\n                0.08,\n                0.09,\n                1.0\n              ],\n              \"parameter_enable\": 1\n            }\n          },\n          \"pick_n\": {\n            \"type\": \"comment\",\n            \"text\": \"every generator below runs at once; this picks the one that reaches [s~ SRC], the scope at the foot of this page, and every waveshaping tab\",\n            \"pos\": [\n              260,\n              294\n            ],\n            \"size\": [\n              300,\n              51\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 9.0,\n              \"textcolor\": [\n                0.68,\n                0.7,\n                0.74,\n                1.0\n              ],\n              \"presentation_linecount\": 3\n            },\n            \"presentation\": [\n              260,\n              294,\n              300,\n              52\n            ],\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"b0_panel\": {\n            \"type\": \"panel\",\n            \"pos\": [\n              20,\n              230\n            ],\n            \"size\": [\n              40,\n              24\n            ],\n            \"presentation\": [\n              20,\n              230,\n              550,\n              394\n            ],\n            \"attrs\": {\n              \"background\": 1,\n              \"rounded\": 6,\n              \"bgcolor\": [\n                0.21,\n                0.22,\n                0.26,\n                1.0\n              ]\n            },\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"b1_title\": {\n            \"type\": \"comment\",\n            \"text\": \"1 \\u00b7 cycle~ \\u2014 sine, or any 512-sample wavetable\",\n            \"pos\": [\n              600,\n              238\n            ],\n            \"size\": [\n              530,\n              21\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 10.0,\n              \"textcolor\": [\n                0.9,\n                0.9,\n                0.92,\n                1.0\n              ],\n              \"fontface\": 1\n            },\n            \"presentation\": [\n              600,\n              238,\n              530,\n              21\n            ],\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"c_freq\": {\n            \"type\": \"attrui\",\n            \"pos\": [\n              600,\n              265\n            ],\n            \"size\": [\n              166,\n              22\n            ],\n            \"presentation\": [\n              600,\n              265,\n              166,\n              22\n            ],\n            \"attrs\": {\n              \"attr\": \"frequency\",\n              \"text_width\": 86,\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 10.0\n            },\n            \"inlets\": 1,\n            \"outlets\": 1,\n            \"outlettype\": [\n              \"\"\n            ]\n          },\n          \"c_freq_n\": {\n            \"type\": \"comment\",\n            \"text\": \"oscillator frequency in Hz; inlet 0 takes the same thing as a float or a signal\",\n            \"pos\": [\n              830,\n              267\n            ],\n            \"size\": [\n              300,\n              36\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 9.0,\n              \"textcolor\": [\n                0.68,\n                0.7,\n                0.74,\n                1.0\n              ],\n              \"presentation_linecount\": 2\n            },\n            \"presentation\": [\n              830,\n              267,\n              300,\n              37\n            ],\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"c_phase\": {\n            \"type\": \"attrui\",\n            \"pos\": [\n              600,\n              309\n            ],\n            \"size\": [\n              141,\n              22\n            ],\n            \"presentation\": [\n              600,\n              309,\n              141,\n              22\n            ],\n            \"attrs\": {\n              \"attr\": \"phase\",\n              \"text_width\": 61,\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 10.0\n            },\n            \"inlets\": 1,\n            \"outlets\": 1,\n            \"outlettype\": [\n              \"\"\n            ]\n          },\n          \"c_phase_n\": {\n            \"type\": \"comment\",\n            \"text\": \"where in the table the cycle starts, 0.-1.; inlet 1 takes this as a signal, which is phase modulation\",\n            \"pos\": [\n              830,\n              311\n            ],\n            \"size\": [\n              300,\n              36\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 9.0,\n              \"textcolor\": [\n                0.68,\n                0.7,\n                0.74,\n                1.0\n              ],\n              \"presentation_linecount\": 2\n            },\n            \"presentation\": [\n              830,\n              311,\n              300,\n              37\n            ],\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"c_boff\": {\n            \"type\": \"attrui\",\n            \"pos\": [\n              600,\n              353\n            ],\n            \"size\": [\n              191,\n              22\n            ],\n            \"presentation\": [\n              600,\n              353,\n              191,\n              22\n            ],\n            \"attrs\": {\n              \"attr\": \"buffer_offset\",\n              \"text_width\": 111,\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 10.0\n            },\n            \"inlets\": 1,\n            \"outlets\": 1,\n            \"outlettype\": [\n              \"\"\n            ]\n          },\n          \"c_boff_n\": {\n            \"type\": \"comment\",\n            \"text\": \"first sample of the buffer to read, when a buffer is supplying the waveform\",\n            \"pos\": [\n              830,\n              355\n            ],\n            \"size\": [\n              300,\n              36\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 9.0,\n              \"textcolor\": [\n                0.68,\n                0.7,\n                0.74,\n                1.0\n              ],\n              \"presentation_linecount\": 2\n            },\n            \"presentation\": [\n              830,\n              355,\n              300,\n              37\n            ],\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"c_bsize\": {\n            \"type\": \"attrui\",\n            \"pos\": [\n              600,\n              397\n            ],\n            \"size\": [\n              213,\n              22\n            ],\n            \"presentation\": [\n              600,\n              397,\n              213,\n              22\n            ],\n            \"attrs\": {\n              \"attr\": \"buffer_sizeinsamps\",\n              \"text_width\": 143,\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 10.0\n            },\n            \"inlets\": 1,\n            \"outlets\": 1,\n            \"outlettype\": [\n              \"\"\n            ]\n          },\n          \"c_bsize_n\": {\n            \"type\": \"comment\",\n            \"text\": \"override the 512-sample window; -1 uses the whole buffer\",\n            \"pos\": [\n              830,\n              399\n            ],\n            \"size\": [\n              300,\n              36\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 9.0,\n              \"textcolor\": [\n                0.68,\n                0.7,\n                0.74,\n                1.0\n              ],\n              \"presentation_linecount\": 2\n            },\n            \"presentation\": [\n              830,\n              399,\n              300,\n              37\n            ],\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"c_tab\": {\n            \"type\": \"message\",\n            \"text\": \"set REFTABLE\",\n            \"pos\": [\n              600,\n              441\n            ],\n            \"size\": [\n              114,\n              22\n            ],\n            \"presentation\": [\n              600,\n              441,\n              114,\n              22\n            ],\n            \"inlets\": 2,\n            \"outlets\": 1,\n            \"outlettype\": [\n              \"\"\n            ]\n          },\n          \"c_tab_n\": {\n            \"type\": \"comment\",\n            \"text\": \"read the shared wavetable at the foot of this page\",\n            \"pos\": [\n              830,\n              443\n            ],\n            \"size\": [\n              300,\n              21\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 9.0,\n              \"textcolor\": [\n                0.68,\n                0.7,\n                0.74,\n                1.0\n              ]\n            },\n            \"presentation\": [\n              830,\n              443,\n              300,\n              21\n            ],\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n     