: {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 13.0,\n              \"fontface\": 1,\n              \"textcolor\": [\n                1.0,\n                0.55,\n                0.0,\n                1.0\n              ]\n            },\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"blurb\": {\n            \"type\": \"comment\",\n            \"text\": \"degrade~ does both jobs in one box.  downsamp~ does only the rate half, and takes it in Hz rather than as a ratio.  Both alias on purpose \\u2014 the extra tones you hear are images of the signal folded back below the new Nyquist, and that is the sound.  Neither has a single attribute, so every control here is an inlet; each block below holds the controls for the object named in its title.\",\n            \"pos\": [\n              20,\n              44\n            ],\n            \"size\": [\n              1100,\n              51\n            ],\n            \"presentation\": [\n              20,\n              44,\n              1100,\n              52\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 10.0,\n              \"textcolor\": [\n                0.9,\n                0.9,\n                0.92,\n                1.0\n              ],\n              \"presentation_linecount\": 3\n            },\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"src_in\": {\n            \"type\": \"newobj\",\n            \"text\": \"r~ SRC\",\n            \"pos\": [\n              20,\n              140\n            ],\n            \"inlets\": 1,\n            \"outlets\": 1,\n            \"outlettype\": [\n              \"\"\n            ]\n          },\n          \"b0_title\": {\n            \"type\": \"comment\",\n            \"text\": \"drive \\u2014 the only control a nonlinearity has\",\n            