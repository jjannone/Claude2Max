      \"textcolor\": [\n                1.0,\n                0.55,\n                0.0,\n                1.0\n              ]\n            },\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"blurb\": {\n            \"type\": \"comment\",\n            \"text\": \"pong~ is the one to reach for: @mode fold reflects the signal back off each bound, wrap jumps it to the other bound, and clip holds it there \\u2014 and that third mode is exactly what clip~ does, so clip~ is not repeated on this page.  Folding is what makes pong~ a timbre generator rather than a limiter: every fold adds harmonics, so raising the drive past the range changes the colour instead of only the loudness.\",\n            \"pos\": [\n              20,\n              44\n            ],\n            \"size\": [\n              1100,\n              51\n            ],\n            \"presentation\": [\n              20,\n              44,\n              1100,\n              52\n            ],\n            \"attrs\": {\n              \"fontname\": \"Monaco\",\n              \"fontsize\": 10.0,\n              \"textcolor\": [\n                0.9,\n                0.9,\n                0.92,\n                1.0\n              ],\n              \"presentation_linecount\": 3\n            },\n            \"inlets\": 1,\n            \"outlets\": 0,\n            \"outlettype\": []\n          },\n          \"src_in\": {\n            \"type\": \"newobj\",\n            \"text\": \"r~ SRC\",\n            \"pos\": [\n              20,\n              140\n            ],\n            \"inlets\": 1,\n            \"outlets\": 1,\n            \"outlettype\": [\n              \"\"\n            ]\n          },\n          \"b0_title\": {\n            \"type\": \"comment\",\n            \"text\": \"drive \\u2014 the only control a nonlinearity has\",\n            \"pos\": [\n              30,\n              238\n            ],\n            \"size\": [\n    